# Environment variables — Funko Inventory
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to the repository.

# ─── GitHub Integration ───────────────────────────────────────────────────────

# Personal Access Token (classic or fine-grained).
# Required scopes: contents:read + contents:write (for read-write access)
# Create at: https://github.com/settings/tokens
VITE_GITHUB_TOKEN=your_personal_access_token_here

# Your GitHub username (e.g. "john-doe")
VITE_GITHUB_OWNER=your_github_username

# Repository name (e.g. "funko-inventory")
VITE_GITHUB_REPO=funko-inventory

# Branch where inventory.json lives (default: main)
VITE_GITHUB_BRANCH=main

# ─── Deployment ───────────────────────────────────────────────────────────────

# Base URL path for GitHub Pages (matches /<repo-name>/)
# Only needed if you override the default in vite.config.js
# VITE_BASE_PATH=/funko-inventory/

# ─── Fase 3 (Cloudflare Worker proxy — added later) ──────────────────────────
# The Claude API key is NOT stored here. It lives in the Cloudflare Worker.
# VITE_WORKER_URL=https://funko-ai.your-worker.workers.dev
